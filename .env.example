# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── External APIs ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_key
OPENAI_API_KEY=your_openai_api_key

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of the app. e.g. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Gmail sending (Sign in with Google) ───────────────────────────────────────
# Sending uses "Sign in with Google" via Supabase. Setup:
#  1. Google Cloud Console: create an OAuth 2.0 Web client, enable the Gmail API.
#     Authorized redirect URI = https://<project-ref>.supabase.co/auth/v1/callback
#     On the OAuth consent screen add the gmail.send scope + your test users.
#  2. Supabase Dashboard → Authentication → Providers → Google: enable it and
#     paste the SAME client ID + secret. Add ${NEXT_PUBLIC_APP_URL}/auth/callback
#     under Authentication → URL Configuration (redirect allow list).
#  3. Put the SAME client ID/secret below — the server needs them to refresh the
#     Google access token when sending.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

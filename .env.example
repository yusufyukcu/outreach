# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── External APIs ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_key
OPENAI_API_KEY=your_openai_api_key

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of the app. Used to build the Gmail OAuth redirect URI.
# e.g. http://localhost:3000 in dev, https://yourdomain.com in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Gmail sending (OAuth) ─────────────────────────────────────────────────────
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Enable the Gmail API. Add this exact Authorized redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/gmail/callback
# While the app is unverified, add your address under OAuth consent > Test users.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
